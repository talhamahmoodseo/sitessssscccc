# Apache config for the static (non-WordPress) build on shared hosting.
#
# Vite copies this file into dist/ on build, so it ships with the site.
# Every page is prerendered to <path>/index.html (scripts/prerender.mjs), so no
# SPA rewrite is needed: real pages are real files, everything else is a 404.
# Serving from a SUBFOLDER? Change the / paths below — see HOSTING.md.

# /about serves about/index.html directly instead of redirecting to /about/
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # the old services index now lives on the homepage
  RewriteRule ^services/?$ /#services [R=301,NE,L]

  # one URL per page: /about/ -> /about
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /about -> about/index.html (internal)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]
</IfModule>

# Unknown URLs: the prerendered not-found page, with a real 404 status
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType application/json .json
</IfModule>

# JavaScript files have content hashes in their names, so they can be cached
# for a year. HTML and app.css revalidate so a redeploy shows up at once.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^app\.css$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(woff2?|jpg|jpeg|png|svg|webp)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
